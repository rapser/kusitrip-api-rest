# Producción: Supabase. Copia este archivo a `.env.production`.
# Lo usan start:dev:prod (API en tu Mac contra Supabase), db:migrate:prod y db:seed:prod.
# Render NO lee este archivo: toma las mismas variables de su panel (Environment).

# Supabase → Project → botón "Connect" → pestaña "ORMs" (Prisma).
# Transaction pooler (puerto 6543): lo usa el API en tiempo de ejecución. Agrega `&connection_limit=1`.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Session pooler (puerto 5432): lo usa Prisma Migrate (IPv4, funciona desde Render).
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Generar con: openssl rand -hex 32 (dos valores distintos, iguales a los de Render)
JWT_SECRET="replace-with-a-random-64-char-hex-secret"
JWT_REFRESH_SECRET="replace-with-a-different-random-64-char-hex-secret"

PORT=3000
NODE_ENV=production
