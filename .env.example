# Supabase → Project → botón "Connect" → pestaña "ORMs" (Prisma).
# Transaction pooler (puerto 6543) — lo usa la app en tiempo de ejecución.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Session pooler (puerto 5432) — lo usa Prisma Migrate (IPv4, funciona desde Render).
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Generar con: openssl rand -hex 32
JWT_SECRET="replace-with-a-random-64-char-hex-secret"
JWT_REFRESH_SECRET="replace-with-a-different-random-64-char-hex-secret"

PORT=3000
NODE_ENV=development

# --- Base local (npm run db:local) — reemplaza las dos URLs de arriba por estas ---
# DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:55432/postgres?sslmode=disable&pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:55432/postgres?sslmode=disable&connection_limit=1"
