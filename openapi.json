  "info": {
    "title": "KusiTrip API",
    "description": "REST API for the KusiTrip iOS app — auth, home, destinations, activities, reviews, search, wishlist and bookings.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Miguel"
          },
          "surname": {
            "type": "string",
            "example": "Tomairo"
          },
          "email": {
            "type": "string",
            "example": "usuario@kusitrip.com"
          },
          "password": {
            "type": "string",
            "example": "kusitrip123",
            "minLength": 8
          }
        },
        "required": [
          "name",
          "surname",
          "email",
          "password"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "usuario@kusitrip.com"
          },
          "password": {
            "type": "string",
            "example": "kusitrip123"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RefreshDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "CategoryResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "excursions"
          },
          "name": {
            "type": "string",
            "example": "Excursiones"
          },
          "icon": {
            "type": "string",
            "example": "bus",
            "description": "SF Symbol name"
          }
        },
        "required": [
          "id",
          "name",
          "icon"
        ]
      },
      "ActivityResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "cusco-excursion-machu-picchu-entradas"
          },
          "title": {
            "type": "string"
          },
          "summary": {
            "type": "string",
            "description": "One-line teaser"
          },
          "description": {
            "type": "string",
            "description": "Long description, paragraphs split by \\n\\n"
          },
          "price": {
            "type": "number",
            "example": 331.74
          },
          "originalPrice": {
            "type": "number",
            "nullable": true
          },
          "currency": {
            "type": "string",
            "example": "USD"
          },
          "rating": {
            "type": "number",
            "example": 9.1,
            "description": "Score out of 10"
          },
          "reviewCount": {
            "type": "number"
          },
          "travelerCount": {
            "type": "number"
          },
          "category": {
            "$ref": "#/components/schemas/CategoryResponseDto"
          },
          "destinationId": {
            "type": "string"
          },
          "imageUrls": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "durationMinutes": {
            "type": "number"
          },
          "language": {
            "type": "string",
            "example": "Español, Inglés"
          },
          "freeCancellationDays": {
            "type": "number",
            "description": "0 when free cancellation is not offered"
          },
          "isFree": {
            "type": "boolean"
          },
          "isFeatured": {
            "type": "boolean"
          },
          "meetingPoint": {
            "type": "string"
          },
          "includes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "title",
          "summary",
          "description",
          "price",
          "originalPrice",
          "currency",
          "rating",
          "reviewCount",
          "travelerCount",
          "category",
          "destinationId",
          "imageUrls",
          "durationMinutes",
          "language",
          "freeCancellationDays",
          "isFree",
          "isFeatured",
          "meetingPoint",
          "includes"
        ]
      },
      "PageMetaDto": {
        "type": "object",
        "properties": {
          "page": {
            "type": "number"
          },
          "limit": {
            "type": "number"
          },
          "total": {
            "type": "number"
          },
          "hasNext": {
            "type": "boolean"
          }
        },
        "required": [
          "page",
          "limit",
          "total",
          "hasNext"
        ]
      },
      "ActivityPageResponseDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ActivityResponseDto"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/PageMetaDto"
          }
        },
        "required": [
          "items",
          "meta"
        ]
      },
      "CreateReviewDto": {
        "type": "object",
        "properties": {
          "rating": {
            "type": "number",
            "example": 9.5,
            "minimum": 0,
            "maximum": 10
          },
          "comment": {
            "type": "string",
            "example": "Una experiencia increíble, el guía fue excelente."
          },
          "city": {
            "type": "string",
            "example": "Lima, Perú"
          },
          "travelType": {
            "type": "string",
            "enum": [
              "pareja",
              "familia",
              "amigos",
              "solo"
            ]
          }
        },
        "required": [
          "rating",
          "comment"
        ]
      },
      "AddFavoriteDto": {
        "type": "object",
        "properties": {
          "activityId": {
            "type": "string",
            "example": "cusco-excursion-machu-picchu-entradas"
          }
        },
        "required": [
          "activityId"
        ]
      },
      "CreateBookingDto": {
        "type": "object",
        "properties": {
          "activityId": {
            "type": "string",
            "example": "cusco-excursion-machu-picchu-entradas"
          },
          "date": {
            "format": "date-time",
            "type": "string",
            "example": "2026-12-15T09:00:00.000Z",
            "description": "ISO-8601 date and time of the activity"
          },
          "numberOfPeople": {
            "type": "number",
            "example": 2,
            "minimum": 1,
            "maximum": 20
          }
        },
        "required": [
          "activityId",
          "date",
          "numberOfPeople"
        ]
      }
    }
  }
}