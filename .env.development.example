# Desarrollo: base PostgreSQL local (PGlite). Enciéndela con `npm run db:local`.
# Copia este archivo a `.env.development` (npm run start:dev / db:migrate / db:seed lo usan).
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:55432/postgres?sslmode=disable&pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:55432/postgres?sslmode=disable&connection_limit=1"

# Generar con: openssl rand -hex 32 (dos valores distintos)
JWT_SECRET="replace-with-a-random-64-char-hex-secret"
JWT_REFRESH_SECRET="replace-with-a-different-random-64-char-hex-secret"

PORT=3000
NODE_ENV=development
